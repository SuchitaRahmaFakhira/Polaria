# Contoh konfigurasi Supabase untuk Polaria.
# Salin menjadi .env lalu isi nilainya:  cp .env.example .env
#
# Ambil dari Supabase → Project Settings → API (atau "Connect"):
#   SUPABASE_URL       = Project URL
#   SUPABASE_ANON_KEY  = anon public key / publishable key (sb_publishable_...)
#
# Kunci ini aman untuk browser karena setiap tabel dilindungi Row Level Security.
# JANGAN isi dengan service_role key / secret key (sb_secret_...).
# API Polaria akan menolak kunci rahasia dan aplikasi kembali ke mode lokal.

SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=isi-anon-key-di-sini

# Tutor AI (Gemini). Kunci RAHASIA: hanya dibaca server, tidak pernah dikirim ke browser.
# Buat di https://aistudio.google.com/apikey
# Catatan: syarat Gemini API melarang pemakaian oleh/untuk pengguna di bawah 18 tahun.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
